{
  "name": "learn-trivy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A visual field guide to Trivy, its databases, and Kubernetes scanning.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:labs": "node scripts/test-trivy-labs.mjs && node scripts/test-evidence-labs.mjs"
  }
}
